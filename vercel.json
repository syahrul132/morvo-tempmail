{
  "version": 2,
  "installCommand": "npm install --omit=dev --no-audit --no-fund --registry=https://registry.npmjs.org/",
  "buildCommand": "npm run vercel-build",
  "functions": {
    "api/index.js": {
      "maxDuration": 10
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index.js"
    }
  ]
}
